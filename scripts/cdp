#!/usr/bin/env python3
"""Small CLI for common operations on the dedicated CDP Chrome.

Heavy lifting (form fill, multi-step flows, scraping) should be done by Claude
writing playwright code directly. This CLI covers the high-frequency one-shots.
"""
import argparse
import json
import sys
from playwright.sync_api import sync_playwright

CDP_URL = "http://localhost:9222"


def _connect(pw):
    browser = pw.chromium.connect_over_cdp(CDP_URL)
    if not browser.contexts:
        print("ERROR: no contexts in CDP Chrome — should be impossible", file=sys.stderr)
        sys.exit(2)
    return browser, browser.contexts[0]


def cmd_list_tabs(_args):
    with sync_playwright() as pw:
        _, ctx = _connect(pw)
        if not ctx.pages:
            print("(no tabs open)")
            return
        for i, p in enumerate(ctx.pages):
            title = (p.title() or "").replace("|", "/")[:60]
            print(f"{i} | {p.url} | {title}")


def cmd_open(args):
    with sync_playwright() as pw:
        _, ctx = _connect(pw)
        page = ctx.new_page()
        page.goto(args.url, wait_until="domcontentloaded", timeout=30000)
        print(f"opened: {page.url}")


def cmd_screenshot(args):
    with sync_playwright() as pw:
        _, ctx = _connect(pw)
        page = ctx.new_page()
        try:
            page.goto(args.url, wait_until="networkidle", timeout=30000)
            page.screenshot(path=args.out, full_page=args.full)
            print(f"saved: {args.out}")
        finally:
            page.close()


def cmd_cookie(args):
    with sync_playwright() as pw:
        _, ctx = _connect(pw)
        cookies = ctx.cookies()
        if args.domain:
            cookies = [c for c in cookies if args.domain in c.get("domain", "")]
        print(json.dumps(cookies, ensure_ascii=False, indent=2))


def cmd_exec(args):
    with sync_playwright() as pw:
        _, ctx = _connect(pw)
        page = ctx.new_page()
        try:
            page.goto(args.url, wait_until="domcontentloaded", timeout=30000)
            result = page.evaluate(args.js)
            print(json.dumps(result, ensure_ascii=False, default=str))
        finally:
            page.close()


def main():
    parser = argparse.ArgumentParser(prog="cdp")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list-tabs").set_defaults(func=cmd_list_tabs)

    p = sub.add_parser("open")
    p.add_argument("url")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("screenshot")
    p.add_argument("url")
    p.add_argument("out", nargs="?", default="/tmp/cdp-shot.png")
    p.add_argument("--full", action="store_true", help="full page screenshot")
    p.set_defaults(func=cmd_screenshot)

    p = sub.add_parser("cookie")
    p.add_argument("domain", nargs="?", help="filter by substring of cookie.domain")
    p.set_defaults(func=cmd_cookie)

    p = sub.add_parser("exec")
    p.add_argument("url")
    p.add_argument("js", help="JS expression, e.g. 'document.title'")
    p.set_defaults(func=cmd_exec)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
